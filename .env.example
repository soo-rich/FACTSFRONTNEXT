# -----------------------------------------------------------------------------
# Runtime — lues au démarrage du conteneur, jamais figées dans le build.
# Les valeurs destinées au navigateur sont injectées dans le HTML à chaque
# requête par src/components/RuntimeEnvScript.tsx (window.__ENV__).
# -----------------------------------------------------------------------------

# URL publique du front (redirections de déconnexion)
APP_URL=http://localhost:3000

# Base de l'API backend, chemin inclus
API_URL=http://localhost:4000/api/v1

# Authentication (NextAuth.js)
NEXTAUTH_BASEPATH=/api/auth
NEXTAUTH_URL=http://localhost:3000/api/auth
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Build — nécessaires au `next build`, une image par valeur.
# -----------------------------------------------------------------------------

# Sous-chemin de service (next.config.ts). Vide = servi à la racine.
BASEPATH=

# Documentation du template Vuexy (liens du menu horizontal)
NEXT_PUBLIC_DOCS_URL=https://demos.pixinvent.com/vuexy-nextjs-admin-template/documentation
